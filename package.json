{
  "name": "codex-quota-guard",
  "version": "0.1.8",
  "private": true,
  "description": "Local Windows quota guard for Codex Desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently -k \"tsc -w -p tsconfig.main.json\" \"vite --host 127.0.0.1 --port 2326 --strictPort\" \"wait-on http://127.0.0.1:2326 && electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.codexquotaguard",
    "productName": "Codex Quota Guard",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
